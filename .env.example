# Copy to .env and adjust. Never commit real values.

# Gateway
PORT=3000
# Port published on the host by the docker-compose files
HOST_PORT=3123
NODE_ENV=production
LOG_LEVEL=info
# Allowed CORS origin. Unset: any in development, none in production
# CORS_ORIGIN=https://app.example.com
# Serve /docs and /openapi.json in production
SWAGGER_ENABLED=false
# Prometheus metrics at /metrics (requires API_KEY)
METRICS_ENABLED=true

# API authentication (REQUIRED in production - gateway will not start without it)
# In development (NODE_ENV=development), a default key is used if not set.
# In production, you MUST set a unique key or the server will refuse to start.
API_KEY=

# Read-only API key (optional) for the message-log read endpoints and the WebSocket event stream.
# Lets consumers read stored messages and media without the full API_KEY. It never gets QR codes or sends.
READ_API_KEY=

# Path to accounts YAML config (inside the data volume)
ACCOUNTS_CONFIG_PATH=/app/data/accounts.yaml

# Webhook callback (where unified envelopes are forwarded)
WEBHOOK_CALLBACK_URL=
WEBHOOK_CALLBACK_SECRET=

# Where to hear that an account went down (Slack-compatible `text` field). Receives a connection.update
# with status auth_expired as soon as an account loses its session (e.g. WhatsApp unlinked the device),
# or disconnected after 15 minutes without connection. Retried until it answers 2xx, repeated every 6 hours
# while the account stays down. Without it nobody is guaranteed to find out.
ALERT_WEBHOOK_URL=

# Health check interval in milliseconds (default: 5 minutes)
HEALTH_CHECK_INTERVAL_MS=300000

# Message persistence (stores inbound + outbound messages)
STORAGE_ENABLED=true
# "sqlite" (default) or "postgres"
STORAGE_DRIVER=sqlite
# SQLite file path (sqlite only)
DATABASE_PATH=data/messages.db
# PostgreSQL URL (postgres only), e.g. postgres://user:password@postgres:5432/messaging
# A password with characters reserved in a URL must be percent-encoded here
DATABASE_URL=
# Password used by the bundled Postgres in docker-compose.prod.example.yml (required there).
# It goes as it is into DATABASE_URL: only letters and digits (openssl rand -hex 32)
POSTGRES_PASSWORD=

# Media and retention
# Directory where inbound media is stored (inside the data volume)
MEDIA_DIR=/app/data/media
# Max size of a downloaded media file in bytes (16 MiB)
MEDIA_MAX_BYTES=16777216
# Days to keep media files (0 = as long as their message). Never longer than MESSAGE_RETENTION_DAYS when that is set
MEDIA_RETENTION_DAYS=30
# Days to keep message rows. Opt-in: 0 (default) = never delete messages; e.g. 180 deletes older ones
MESSAGE_RETENTION_DAYS=0
