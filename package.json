{
  "name": "unified-messaging-gateway",
  "version": "0.5.1",
  "description": "Unified Messaging Gateway - Single point of contact for all messaging integrations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:copy-migrations",
    "build:copy-migrations": "node --input-type=module -e \"import{cpSync}from'node:fs';cpSync('src/persistence/migrations/scripts','dist/persistence/migrations/scripts',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "sdk:generate": "npm run openapi:export && cd packages/sdk && npm run generate && node ../../scripts/fix-generated-imports.js",
    "sdk:build": "cd packages/sdk && npm run build"
  },
  "keywords": [
    "messaging",
    "gateway",
    "whatsapp",
    "telegram",
    "email",
    "sms"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "orval": "^8.28.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
